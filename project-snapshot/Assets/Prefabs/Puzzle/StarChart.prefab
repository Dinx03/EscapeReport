  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f41a25b5b4be4bb46bdc35ebcaf6d034, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EscapeRoom.Interaction::WrittenPage
  heading: "\u0E01\u0E25\u0E38\u0E48\u0E21\u0E14\u0E32\u0E27\u0E42\u0E2E\u0E42\u0E23\u0E42\u0E25\u0E08\u0E34\u0E2D\u0E38\u0E21
    \u2014 \u0E19\u0E32\u0E2C\u0E34\u0E01\u0E32\u0E25\u0E39\u0E01\u0E15\u0E38\u0E49\u0E21"
  body: "\u0E2B\u0E01\u0E14\u0E27\u0E07 \u0E40\u0E23\u0E35\u0E22\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E15\u0E30\u0E02\u0E2D\u0E22\u0E32\u0E27
    \u0E19\u0E35\u0E48\u0E04\u0E37\u0E2D\u0E23\u0E39\u0E1B\u0E17\u0E35\u0E48\u0E16\u0E39\u0E01\u0E15\u0E49\u0E2D\u0E07\n\u0E41\u0E2A\u0E07\u0E08\u0E31\u0E19\u0E17\u0E23\u0E4C\u0E1C\u0E48\u0E32\u0E19\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21\u0E17\u0E31\u0E49\u0E07\u0E2A\u0E32\u0E21\u0E41\u0E25\u0E49\u0E27\u0E15\u0E01\u0E25\u0E07\u0E1A\u0E19\u0E09\u0E32\u0E01\n\u0E2B\u0E21\u0E38\u0E19\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21\u0E08\u0E19\u0E08\u0E38\u0E14\u0E41\u0E2A\u0E07\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E01\u0E17\u0E31\u0E1A\u0E23\u0E2D\u0E22\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E01\u0E1A\u0E19\u0E09\u0E32\u0E01\n\u0E41\u0E25\u0E49\u0E27\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49
    \u0E01\u0E25\u0E44\u0E01\u0E08\u0E30\u0E25\u0E47\u0E2D\u0E01\u0E15\u0E31\u0E27\u0E21\u0E31\u0E19\u0E40\u0E2D\u0E07\n\n\u0E1B\u0E23\u0E34\u0E0B\u0E36\u0E21\u0E41\u0E15\u0E48\u0E25\u0E30\u0E41\u0E17\u0E48\u0E07\u0E17\u0E33\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E40\u0E14\u0E35\u0E22\u0E27
    \u0E2B\u0E21\u0E38\u0E19\u0E41\u0E25\u0E49\u0E27\u0E14\u0E39\u0E17\u0E35\u0E48\u0E09\u0E32\u0E01\u0E01\u0E47\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E2D\u0E31\u0E19\u0E44\u0E2B\u0E19\u0E17\u0E33\u0E2D\u0E30\u0E44\u0E23"
